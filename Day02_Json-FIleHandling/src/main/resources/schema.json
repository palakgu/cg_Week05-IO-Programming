{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "books": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {"type": "string"},
          "author": {"type": "string"},
          "publishedYear": {"type": "integer"},
          "genres": {
            "type": "array",
            "items": {"type": "string"}
          }
        },
        "required": ["title", "author", "publishedYear", "genres"]
      }
    }
  },
  "required": ["books"]
}
